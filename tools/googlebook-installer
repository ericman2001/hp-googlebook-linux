def choose_slot(st, ip):
    active = getvar(ip, 'current-slot').lstrip('_')
    if active not in ('a', 'b'):
        raise Abort(f'unexpected current slot "{active}"')
    other = 'b' if active == 'a' else 'a'
    say(SLOT_HELP)
    say(f'The active slot is {active.upper()}.')
    if ask_yes(f'Is slot {active.upper()} stock Android (a freshly unlocked laptop)?'):
        slot = other
    elif ask_yes(f'Is it a Gentoo install you want to replace?'):
        slot = active
    else:
        raise Abort('not sure which slot to use; nothing was written')
    say(f'Gentoo goes on slot {slot.upper()}; slot {("b" if slot == "a" else "a").upper()} '
        'is left alone.')
    st['slot'] = slot
    st['active_slot'] = active


def stock_dir(st):
    return TOP / 'stock' / st['serial']


def gpt_partitions(f):
    """{name: (offset, size)} from a disk or disk image's GPT."""
    for sector in (512, 4096):
        f.seek(sector)
        hdr = f.read(92)
        if hdr[:8] == b'EFI PART':
            break
    else:
        raise Abort('no GPT found')
    lba, count, esize = struct.unpack_from('<QII', hdr, 72)
    f.seek(lba * sector)
    table = f.read(count * esize)
    parts = {}
    for i in range(count):
        e = table[i * esize:(i + 1) * esize]
        first, last = struct.unpack_from('<QQ', e, 32)
        name = e[56:128].decode('utf-16-le', 'replace').split('\0', 1)[0]
        if first and name:
            parts[name] = (first * sector, (last - first + 1) * sector)
    return parts


STOCK_HELP = """
If you have HP's recovery USB drive (or an image of it), the installer can
take the stock vbmeta and the DSP firmware from it. That's optional: without
it, the installer makes its own vbmeta, and the laptop copies its DSP
firmware from its own modem_a partition on first boot.
"""


def phase_stock(st):
    heading('Stock files (optional)')
    d = stock_dir(st)
    if all((d / f'{p}.img').exists() for p in STOCK_PARTS):
        say(f'Using the stock files in {d}.')
        return
    say(STOCK_HELP)
    src = ask('Recovery drive (e.g. /dev/sdb) or image file, or Enter to skip', '')
    if not src:
        say('Skipped: the installer makes its own vbmeta.')
        return
    src = Path(src).expanduser()
    d.mkdir(parents=True, exist_ok=True)
    os.chmod(d, 0o700)
    try:
        f = open(src, 'rb')
    except PermissionError:
        say(f'  {src} needs root to read; using sudo to copy it')
        f = None
    if f is None:
        with tempfile.NamedTemporaryFile(dir=d) as t:
            run(['sudo', 'dd', f'if={src}', f'of={t.name}', 'bs=1M', 'count=1'],
                log='stock')
            parts = gpt_partitions(open(t.name, 'rb'))
        for p in STOCK_PARTS:
            if p not in parts:
                raise Abort(f'{src} has no {p} partition: is it the Googlebook recovery drive?')
            off, size = parts[p]
            run(['sudo', 'dd', f'if={src}', f'of={d / p}.img', 'bs=4096',
                 f'skip={off // 4096}', f'count={size // 4096}'], log='stock')
            run(['sudo', 'chown', f'{os.getuid()}:{os.getgid()}', f'{d / p}.img'], log='stock')
    else:
        with f:
            parts = gpt_partitions(f)
            for p in STOCK_PARTS:
                if p not in parts:
                    raise Abort(f'{src} has no {p} partition: is it the Googlebook recovery drive?')
                off, size = parts[p]
                f.seek(off)
                with open(d / f'{p}.img', 'wb') as out:
                    left = size
                    while left:
                        block = f.read(min(left, 1 << 20))
                        out.write(block)
                        left -= len(block)
    with open(d / 'vbmeta_a.img', 'rb') as f:
        if f.read(4) != b'AVB0':
            raise Abort('vbmeta_a is not a vbmeta image')
    Fat(d / 'modem_a.img').listdir('image')
    say(f'  vbmeta_a and modem_a copied to {d}')


def generated_vbmeta(path):
    """A vbmeta image with no signature and no descriptors, flagged
    HASHTREE_DISABLED | VERIFICATION_DISABLED. On an unlocked laptop libavb
    then loads the boot partitions without checking them, the same path the
    stock vbmeta takes once those flags are set."""
    hdr = bytearray(256)
    hdr[0:4] = b'AVB0'
    struct.pack_into('>II', hdr, 4, 1, 0)        # required libavb version 1.0
    struct.pack_into('>I', hdr, 120, 3)          # flags
    hdr[128:128 + 22] = b'googlebook-installer 1'
    Path(path).write_bytes(bytes(hdr) + bytes(4096 - 256))


