def build_rootfs(plan):
    top, work = Path(plan['top']), Path(plan['work'])
    s = plan['settings']
    root = work / 'rootfs'
    if root.exists():
        assert root.name == 'rootfs' and root.parent == work
        run(['rm', '-rf', '--one-file-system', str(root)], log='rootfs')
    root.mkdir(mode=0o755)

    def path(p):
        """A path inside the new root. The stage3 is merged-/usr, so /lib
        and friends are symlinks; resolve them here rather than letting the
        host follow them."""
        parts = Path(p).relative_to('/').parts
        if parts and parts[0] in ('lib', 'lib64', 'bin', 'sbin'):
            parts = ('usr', 'bin' if parts[0] in ('bin', 'sbin') else parts[0]) + parts[1:]
        return root.joinpath(*parts)

    def write(p, text, mode=0o644):
        f = path(p)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(text)
        os.chmod(f, mode)
        os.chown(f, 0, 0)

    def edit(p, fn):
        f = path(p)
        f.write_text(fn(f.read_text()))

    say('  unpacking the stage3')
    # /dev is left empty: systemd mounts a devtmpfs there at boot
    run(['tar', '-C', str(root), '-xpJf', plan['stage3'], '--numeric-owner',
         '--xattrs', '--xattrs-include=*', '--exclude=./dev/*'], log='rootfs')

    say('  kernel modules, firmware and Googlebook files')
    rel = plan['kernelrelease']
    mods = path('/lib/modules')
    mods.mkdir(parents=True, exist_ok=True)
    run(['cp', '-a', str(work / 'modules/lib/modules' / rel), str(mods)], log='rootfs')
    run(['chown', '-R', '0:0', str(mods / rel)], log='rootfs')
    # Links to the kernel tree on this PC
    for link in ('build', 'source'):
        if (mods / rel / link).is_symlink():
            (mods / rel / link).unlink()

    fw = path('/lib/firmware')
    for name in LFW_FILES:
        dest = fw / name
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(top / 'downloads/linux-firmware' / name, dest)
    upd = fw / 'updates/ath12k/WCN7850/hw2.0'
    upd.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(work / 'board.bin', upd / 'board.bin')
    (upd / 'README').write_text(
        'board.bin: the linux-firmware board-2.bin entry for board ID 0x112\n'
        '(shared by the other board-0x112 cards), since HP\'s subsystem ID\n'
        '103c:8e64 has no entry. See docs/FIRMWARE.md in hp-googlebook-linux.\n')
    modem = Path(plan['stock']) / 'modem_a.img'
    if modem.exists():
        copy_device_firmware(modem, fw / 'qcom/x1e80100/google/quartz', work)
    else:
        say('  device firmware: copied from the laptop\'s modem_a on first boot')

    copy_tree(top / 'gentoo', root, path)
    share = path('/usr/local/share/googlebook')
    share.mkdir(parents=True, exist_ok=True)
    for f in ['rescue.cpio', 'vendor.cpio', 'placeholder.dtbo', 'vbmeta.img']:
        shutil.copyfile(work / 'out' / f, share / f)
    lib = path('/var/lib/googlebook')
    lib.mkdir(parents=True, exist_ok=True)
    (lib / 'kernel').write_text(rel + '\n')

    say('  configuration')
    write('/etc/hostname', s['hostname'] + '\n')
    # googlebook-install-kernel reads the slot from /proc/bootconfig; this
    # is its fallback
    write('/etc/googlebook/slot', f'_{plan["slot"]}\n')
    rootdev = '/dev/mapper/root' if s.get('encrypt') else 'LABEL=gentoo'
    write('/etc/fstab', '# <fs>\t\t<mountpoint>\t<type>\t<opts>\t\t\t\t<dump> <pass>\n'
          f'{rootdev}\t/\t\text4\tdefaults,noatime,x-systemd.growfs\t0 1\n')
    if s.get('encrypt'):
        # The rescue initramfs unlocks userdata as /dev/mapper/root; later
        # kernels get the same command line from here
        edit('/etc/googlebook/cmdline', lambda t: t.replace(
            'root=LABEL=gentoo', 'gbcrypt=userdata root=/dev/mapper/root'))
        if 'gbcrypt=userdata' not in path('/etc/googlebook/cmdline').read_text():
            raise Abort('could not set the encrypted root in /etc/googlebook/cmdline')
    tz = path('/etc/localtime')
    tz.unlink(missing_ok=True)
    os.symlink(f'../usr/share/zoneinfo/{s["timezone"]}', tz)
    charset = s['locale'].split('.', 1)[1] if '.' in s['locale'] else 'UTF-8'
    edit('/etc/locale.gen', lambda t: t + f'\n{s["locale"]} {charset}\n')
    write('/etc/locale.conf', f'LANG={s["locale"]}\n')
    write('/etc/vconsole.conf', f'KEYMAP={s["keymap"]}\n')
    path('/etc/resolv.conf').unlink(missing_ok=True)
    os.symlink('../run/systemd/resolve/stub-resolv.conf', path('/etc/resolv.conf'))
    write('/etc/systemd/network/50-wired.network',
          '# Wired networking until googlebook-postinstall installs NetworkManager\n'
          '[Match]\nType=ether\n\n[Network]\nDHCP=yes\n\n[DHCPv4]\nClientIdentifier=mac\n')
    write('/etc/motd', '\nFinish the setup as root: googlebook-postinstall [--gnome]\n\n')

    add_users(path, s)

    with open(path('/etc/portage/make.conf'), 'a') as f:
        f.write(f"""
# Added by googlebook-installer
# Shorter emerge output; keep build dependencies up to date too
EMERGE_DEFAULT_OPTS="-q --with-bdeps=y"
MAKEOPTS="-j12 -l12"
# Gentoo binary packages, signature-checked (see /etc/portage/binrepos.conf)
FEATURES="${{FEATURES}} getbinpkg binpkg-request-signature"
# linux-firmware needs @BINARY-REDISTRIBUTABLE
ACCEPT_LICENSE="-* @FREE @BINARY-REDISTRIBUTABLE"
VIDEO_CARDS="freedreno"
""")
    write('/etc/portage/package.use/kernel',
          'sys-kernel/gentoo-kernel -initramfs -debug\nsys-kernel/installkernel -dracut\n')
    write('/etc/portage/package.accept_keywords/kernel',
          f'=sys-kernel/gentoo-kernel-{KVER} ~arm64\n=virtual/dist-kernel-{KVER} ~arm64\n')

    for unit, target in [('systemd-networkd.service', 'multi-user.target'),
                         ('systemd-networkd.socket', 'sockets.target'),
                         ('systemd-resolved.service', 'multi-user.target'),
                         ('sshd.service', 'multi-user.target')]:
        enable(path, f'/usr/lib/systemd/system/{unit}', target)
    enable(path, '/etc/systemd/system/googlebook-firstboot.service', 'multi-user.target')

    img = work / 'rootfs.img'
    used = int(subprocess.run(['du', '-sxB1', str(root)], capture_output=True,
                              text=True, check=True).stdout.split()[0])
    size = max(8 << 30, (used * 13 // 10 + (2 << 30)) // (1 << 30) * (1 << 30))
    say(f'  making a {size >> 30} GiB ext4 image ({used >> 20} MiB used); '
        'it grows to the whole disk on first boot')
    if img.exists():
        img.unlink()
    if s.get('encrypt'):
        make_encrypted_fs(root, img, size, plan['passphrase'])
    else:
        run(['truncate', '-s', str(size), str(img)], log='rootfs')
        run(['mke2fs', '-q', '-t', 'ext4', '-L', 'gentoo', '-d', str(root), str(img)],
            log='rootfs')
    os.chown(img, plan['uid'], plan['gid'])
    run(['rm', '-rf', '--one-file-system', str(root)], log='rootfs')


class Fat:
    """Just enough of a FAT12/16/32 reader to copy files out of an image,
    without mounting it."""

    def __init__(self, path):
        self.f = open(path, 'rb')
        b = self.f.read(512)
        self.bps, = struct.unpack_from('<H', b, 11)
        self.spc = b[13]
        rsvd, = struct.unpack_from('<H', b, 14)
        nfats = b[16]
        rootents, tot16, = struct.unpack_from('<HH', b, 17)
        fatsz, = struct.unpack_from('<H', b, 22)
        tot32, fatsz32, _, _, self.rootclus = struct.unpack_from('<IIHHI', b, 32)
        fatsz = fatsz or fatsz32
        total = tot16 or tot32
        self.fat_off = rsvd * self.bps
        self.root_off = (rsvd + nfats * fatsz) * self.bps
        self.root_len = rootents * 32
        self.data_off = self.root_off + -(-self.root_len // self.bps) * self.bps
        clusters = (total * self.bps - self.data_off) // (self.spc * self.bps)
        self.bits = 12 if clusters < 4085 else 16 if clusters < 65525 else 32
        self.f.seek(self.fat_off)
        self.fat = self.f.read(fatsz * self.bps)

    def _next(self, c):
        if self.bits == 16:
            return struct.unpack_from('<H', self.fat, c * 2)[0]
        if self.bits == 32:
            return struct.unpack_from('<I', self.fat, c * 4)[0] & 0x0fffffff
        v, = struct.unpack_from('<H', self.fat, c * 3 // 2)
        return v >> 4 if c & 1 else v & 0xfff

    def _chain(self, c):
        end = {12: 0xff8, 16: 0xfff8, 32: 0x0ffffff8}[self.bits]
        size = self.spc * self.bps
        while 2 <= c < end:
            self.f.seek(self.data_off + (c - 2) * size)
            yield self.f.read(size)
            c = self._next(c)

    def _entries(self, raw):
        lfn = {}
        for i in range(0, len(raw) - 31, 32):
            e = raw[i:i + 32]
            if e[0] == 0:
                break
            if e[0] == 0xe5:
                lfn = {}
                continue
            if e[11] == 0x0f:
                part = (e[1:11] + e[14:26] + e[28:32]).decode('utf-16-le', 'replace')
                lfn[e[0] & 0x1f] = part.split('\0', 1)[0]
                continue
            if e[11] & 0x08:
                lfn = {}
                continue
            if lfn:
                name = ''.join(lfn[k] for k in sorted(lfn))
            else:
                base = e[0:8].decode('latin-1').rstrip()
                ext = e[8:11].decode('latin-1').rstrip()
                base = base.lower() if e[12] & 0x08 else base
                ext = ext.lower() if e[12] & 0x10 else ext
                name = base + ('.' + ext if ext else '')
            lfn = {}
            hi, = struct.unpack_from('<H', e, 20)
            lo, size = struct.unpack_from('<HI', e, 26)
            yield name, bool(e[11] & 0x10), hi << 16 | lo, size

    def listdir(self, path):
        if self.bits == 32:
            raw = b''.join(self._chain(self.rootclus))
        else:
            self.f.seek(self.root_off)
            raw = self.f.read(self.root_len)
        entries = list(self._entries(raw))
        for comp in [c for c in path.split('/') if c]:
            match = [e for e in entries if e[0].lower() == comp.lower() and e[1]]
            if not match:
                raise FileNotFoundError(path)
            entries = list(self._entries(b''.join(self._chain(match[0][2]))))
        return {e[0]: e for e in entries if e[0] not in ('.', '..')}

    def copy(self, entry, dest):
        _, _, cluster, size = entry
        with open(dest, 'wb') as out:
            for block in self._chain(cluster):
                out.write(block[:size])
                size -= len(block)
                if size <= 0:
                    break


LUKS_HEADER = 16 << 20


def make_encrypted_fs(root, img, size, passphrase):
    """An ext4 filesystem of the given size in a LUKS2 container. Opened from
    the whole userdata partition, the container spans all of it, so only the
    filesystem needs to grow on first boot. The KDF cost is fixed rather than
    benchmarked on this PC: about a second on the laptop."""
    if not passphrase:
        raise Abort('no passphrase given')
    run(['truncate', '-s', str(size + LUKS_HEADER), str(img)], log='rootfs')
    luks = ['cryptsetup', '--batch-mode', '--key-file=-']
    r = subprocess.run(luks + ['luksFormat', '--type', 'luks2', '--label', 'gentoo-root',
                               '--cipher', 'aes-xts-plain64', '--key-size', '512',
                               '--sector-size', '4096', '--pbkdf', 'argon2id',
                               '--pbkdf-memory', '1048576', '--pbkdf-parallel', '4',
                               '--pbkdf-force-iterations', '6', str(img)],
                       input=passphrase)
    if r.returncode:
        raise Abort('cryptsetup luksFormat failed')
    name = f'gbinstall-{os.getpid()}'
    r = subprocess.run(luks + ['open', str(img), name], input=passphrase)
    if r.returncode:
        raise Abort('cryptsetup open failed')
    try:
        # nodiscard: discarding the container file doesn't zero what the
        # filesystem reads back, so mke2fs must write its tables itself
        run(['mke2fs', '-q', '-t', 'ext4', '-L', 'gentoo', '-E', 'nodiscard',
             '-d', str(root), f'/dev/mapper/{name}'], log='rootfs')
    finally:
        run(['cryptsetup', 'close', name], log='rootfs')


def copy_device_firmware(modem, dest, work):
    """The ADSP/CDSP firmware is signed for this laptop model; it lives in
    the modem_a partition (FAT) under image/."""
    dest.mkdir(parents=True, exist_ok=True)
    fat = Fat(modem)
    image = fat.listdir('image')
    names = sorted(n for n in image if not image[n][1] and
                   re.match(r'(adsp|cdsp).*\.(mdt|b\d\d)$|.*\.jsn$', n))
    if 'adsp.mdt' not in names:
        raise Abort('modem_a has no image/adsp.mdt')
    for n in names:
        fat.copy(image[n], dest / n)
    if 'kiwi' in image:
        (dest / 'kiwi').mkdir(exist_ok=True)
        for n, e in fat.listdir('image/kiwi').items():
            if not e[1]:
                fat.copy(e, dest / 'kiwi' / n)
    (dest / 'README').write_text(
        'Device-specific firmware for the HP Googlebook (Quartz), copied by\n'
        'googlebook-installer from this laptop\'s modem_a partition (image/).\n'
        'Not owned by any package.\n')
    say(f'  device firmware: {len(names)} files from modem_a')


def copy_tree(src, root, path):
    """Install the repository's gentoo/ tree, owned by root."""
    for d, dirs, files in os.walk(src):
        rel = Path('/') / Path(d).relative_to(src)
        for name in dirs:
            p = path(rel / name)
            if os.path.islink(Path(d) / name):
                continue
            p.mkdir(parents=True, exist_ok=True)
        for name in files:
            if rel == Path('/') and name == 'README.md':
                continue
            s = Path(d) / name
            dest = path(rel / name)
            dest.parent.mkdir(parents=True, exist_ok=True)
            if dest.is_symlink() or dest.exists():
                dest.unlink()
            if s.is_symlink():
                os.symlink(os.readlink(s), dest)
                os.lchown(dest, 0, 0)
                continue
            shutil.copyfile(s, dest)
            os.chmod(dest, 0o755 if os.access(s, os.X_OK) else 0o644)
            os.chown(dest, 0, 0)
        for name in dirs:
            s = Path(d) / name
            if s.is_symlink():
                dest = path(rel / name)
                if not dest.exists():
                    os.symlink(os.readlink(s), dest)


def enable(path, unit, target):
    wants = path(f'/etc/systemd/system/{target}.wants')
    wants.mkdir(parents=True, exist_ok=True)
    link = wants / Path(unit).name
    if not link.is_symlink():
        os.symlink(unit, link)


def add_users(path, s):
    user, uid = s['user'], 1000

    def shadow_set(text, name, hashed):
        out = []
        for line in text.splitlines():
            f = line.split(':')
            if f[0] == name:
                f[1] = hashed
                f[2] = str(int(time.time() // 86400))
                line = ':'.join(f)
            out.append(line)
        return '\n'.join(out) + '\n'

    passwd = path('/etc/passwd').read_text()
    if not re.search(rf'^{user}:', passwd, re.M):
        passwd += f'{user}:x:{uid}:{uid}:{s["fullname"]}:/home/{user}:/bin/bash\n'
        path('/etc/passwd').write_text(passwd)
        group = path('/etc/group').read_text()
        group += f'{user}:x:{uid}:\n'
        extra = ['wheel', 'audio', 'video', 'input', 'render', 'usb', 'lp', 'users']
        lines = []
        for line in group.splitlines():
            f = line.split(':')
            if f[0] in extra:
                members = [m for m in f[3].split(',') if m] + [user]
                f[3] = ','.join(members)
                line = ':'.join(f)
            lines.append(line)
        path('/etc/group').write_text('\n'.join(lines) + '\n')
        sh = path('/etc/shadow')
        sh.write_text(sh.read_text() + f'{user}:!:0:0:99999:7:::\n')
        gs = path('/etc/gshadow')
        if gs.exists():
            gs.write_text(gs.read_text() + f'{user}:!::\n')
    sh = path('/etc/shadow')
    t = shadow_set(sh.read_text(), 'root', s['root_hash'])
    sh.write_text(shadow_set(t, user, s['user_hash']))
    os.chmod(sh, 0o640)

    home = path(f'/home/{user}')
    if not home.exists():
        shutil.copytree(path('/etc/skel'), home, symlinks=True)
    os.chmod(home, 0o700)
    if s['ssh_key']:
        for d in (home / '.ssh', path('/root/.ssh')):
            d.mkdir(mode=0o700, exist_ok=True)
            (d / 'authorized_keys').write_text(s['ssh_key'] + '\n')
            os.chmod(d / 'authorized_keys', 0o600)
    for d, _, files in os.walk(home):
        os.chown(d, uid, uid)
        for f in files:
            os.lchown(os.path.join(d, f), uid, uid)


# --- main --------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(description='Install Gentoo on an HP Googlebook.',
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog='Phases: ' + ', '.join(PHASES))
    ap.add_argument('--from', dest='start', choices=PHASES,
                    help='redo this phase and the ones after it')
    ap.add_argument('--only', choices=PHASES, help='run just this phase')
    ap.add_argument('--ip', help="the laptop's IP address in fastboot mode")
    ap.add_argument('--root-helper', help=argparse.SUPPRESS)
    a = ap.parse_args()
    sys.stdout.reconfigure(line_buffering=True)
    if a.root_helper:
        return root_helper(a.root_helper)

    st = State()
    if a.ip:
        st['ip'] = a.ip
    if a.only:
        todo = [a.only]
    else:
        start = PHASES.index(a.start) if a.start else 0
        todo = [p for i, p in enumerate(PHASES)
                if i >= start and (a.start or p not in st['done'])]
        if a.start:
            st['done'] = [p for p in st['done'] if PHASES.index(p) < start]
    say(f'{BOLD}Gentoo installer for the HP Googlebook{OFF} (work directory: {WORK})')
    try:
        for p in todo:
            globals()[f'phase_{p}'](st)
            if p not in st['done']:
                st['done'] = st['done'] + [p]
    except Abort as e:
        warn(str(e))
        say(f'Run {sys.argv[0]} again to continue from here.')
        return 1
    except KeyboardInterrupt:
        say('\nInterrupted. Run the installer again to continue.')
        return 130
    return 0


if __name__ == '__main__':
    sys.exit(main())
