# --- terminal ---------------------------------------------------------------

BOLD = '\033[1m' if sys.stdout.isatty() else ''
RED = '\033[31m' if sys.stdout.isatty() else ''
OFF = '\033[0m' if sys.stdout.isatty() else ''


def heading(text):
    print(f'\n{BOLD}== {text}{OFF}')


def say(text=''):
    print(text)


def warn(text):
    print(f'{RED}{BOLD}!!{OFF} {text}')


class Abort(Exception):
    pass


def ask(prompt, default=None):
    suffix = f' [{default}]' if default else ''
    while True:
        try:
            reply = input(f'{prompt}{suffix}: ').strip()
        except EOFError:
            raise Abort('no input')
        if reply:
            return reply
        if default is not None:
            return default


def ask_yes(prompt, default=True):
    reply = ask(prompt + (' (Y/n)' if default else ' (y/N)'), '').lower()
    return default if not reply else reply.startswith('y')


def pause(prompt='Press Enter when done'):
    try:
        input(f'{prompt}... ')
    except EOFError:
        raise Abort('no input')


def ask_password(who):
    while True:
        a = getpass.getpass(f'Password for {who}: ')
        if len(a) < 6:
            say('Use at least 6 characters.')
            continue
        if getpass.getpass('Again: ') == a:
            return a
        say("They don't match. Try again.")


# --- helpers ----------------------------------------------------------------

def run(cmd, log=None, cwd=None, env=None, check=True, quiet=False):
    """Run a command. With log, its output goes to work/logs/<log>.log and
    the end of it is shown if it fails."""
    full_env = dict(os.environ, **(env or {}))
    if log is None:
        r = subprocess.run(cmd, cwd=cwd, env=full_env,
                           stdout=subprocess.DEVNULL if quiet else None)
    else:
        LOGS.mkdir(parents=True, exist_ok=True)
        path = LOGS / f'{log}.log'
        with open(path, 'a') as f:
            f.write(f'\n$ {" ".join(map(str, cmd))}\n')
            f.flush()
            r = subprocess.run(cmd, cwd=cwd, env=full_env, stdout=f,
                               stderr=subprocess.STDOUT)
    if check and r.returncode != 0:
        if log is not None:
            lines = (LOGS / f'{log}.log').read_text(errors='replace').splitlines()
            say('\n'.join(lines[-30:]))
            raise Abort(f'{cmd[0]} failed (full log: {LOGS / (log + ".log")})')
        raise Abort(f'{" ".join(map(str, cmd))} failed')
    return r.returncode


def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for block in iter(lambda: f.read(1 << 20), b''):
            h.update(block)
    return h.hexdigest()


def download(url, dest, want_sha256=None):
    dest = Path(dest)
    if dest.exists() and (want_sha256 is None or sha256(dest) == want_sha256):
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    tmp = dest.with_name(dest.name + '.part')
    say(f'  downloading {url}')
    resume = ['-C', '-'] if tmp.exists() else []
    run(['curl', '-fL', '--retry', '3', '--progress-bar', *resume, '-o', str(tmp), url])
    if want_sha256 and sha256(tmp) != want_sha256:
        tmp.unlink()
        raise Abort(f'{dest.name}: checksum mismatch, download removed')
    tmp.rename(dest)
    return dest


def fetch_text(url):
    with urllib.request.urlopen(url, timeout=60) as r:
        return r.read().decode()


class State:
    def __init__(self):
        self.data = json.loads(STATE.read_text()) if STATE.exists() else {}
        self.data.setdefault('done', [])
        self.data.setdefault('settings', {})

    def save(self):
        WORK.mkdir(parents=True, exist_ok=True)
        tmp = STATE.with_suffix('.tmp')
        tmp.write_text(json.dumps(self.data, indent=1))
        os.chmod(tmp, 0o600)
        tmp.rename(STATE)

    def __getitem__(self, key):
        return self.data[key]

    def get(self, key, default=None):
        return self.data.get(key, default)

    def __setitem__(self, key, value):
        self.data[key] = value
        self.save()


# --- fastboot ---------------------------------------------------------------

class FastbootTcp:
    """Depthcharge's fastboot over TCP: 'FB01' handshake, then messages
    with an 8-byte big-endian length. Used for getvar; flashing goes
    through the fastboot tool."""

    def __init__(self, ip, timeout=30):
        self.s = socket.create_connection((ip, 5554), timeout=timeout)
        self.s.sendall(b'FB01')
        hello = self._recv_exact(4)
        if hello[:2] != b'FB':
            raise Abort(f'unexpected fastboot handshake {hello!r}')

    def _recv_exact(self, n):
        buf = bytearray()
        while len(buf) < n:
            chunk = self.s.recv(n - len(buf))
            if not chunk:
                raise Abort('fastboot connection closed')
            buf += chunk
        return bytes(buf)

    def _send(self, data):
        self.s.sendall(struct.pack('>Q', len(data)) + data)

    def _recv(self):
        n, = struct.unpack('>Q', self._recv_exact(8))
        return self._recv_exact(n)

    def getvar(self, name):
        self._send(f'getvar:{name}'.encode())
        while True:
            msg = self._recv()
            kind, rest = msg[:4], msg[4:].decode(errors='replace').strip(' \t\r\n\0')
            if kind == b'OKAY':
                return rest
            if kind != b'INFO':
                raise Abort(f'fastboot getvar {name}: {kind.decode()} {rest}')

    def close(self):
        self.s.close()


def fastboot(ip, *args):
    """Run the fastboot tool, with its progress on the terminal."""
    return run(['fastboot', '-s', f'tcp:{ip}', *args])


def getvar(ip, name, timeout=30):
    fb = FastbootTcp(ip, timeout)
    try:
        return fb.getvar(name)
    finally:
        fb.close()


def wait_for_fastboot(ip, tries=1):
    for i in range(tries):
        try:
            return getvar(ip, 'product', timeout=5)
        except (OSError, Abort):
            if i + 1 < tries:
                time.sleep(3)
    return None


# --- phases -----------------------------------------------------------------

def phase_check(st):
    heading('Checking this PC')
    if os.geteuid() == 0:
        raise Abort('run this as a normal user; it asks for sudo when needed')
    missing = [t for t in HOST_TOOLS if not shutil.which(t)
               and not Path('/sbin', t).exists() and not Path('/usr/sbin', t).exists()]
    if missing:
        say('Missing tools (and the package that usually provides them):')
        for t in missing:
            say(f'  {t:14} {HOST_TOOLS[t]}')
        raise Abort('install them and run the installer again')
    targets = subprocess.run(['clang', '--print-targets'], capture_output=True,
                             text=True).stdout
    if 'aarch64' not in targets:
        raise Abort('clang has no AArch64 target; install a full LLVM/clang')
    if not shutil.which('gpg'):
        warn('gpg not found: the stage3 is checked by SHA-256 over HTTPS only')
    free = shutil.disk_usage(TOP).free >> 30
    if free < 30:
        raise Abort(f'{TOP} has {free} GiB free; the build needs about 30 GiB')
    say(f'All tools found; {free} GiB free in {TOP}.')
    say('You also need: a USB Ethernet adapter (or a USB-C hub with Ethernet)\n'
        'for the laptop, on the same wired network as this PC, with DHCP.')


def guess_timezone():
    try:
        link = os.readlink('/etc/localtime')
        return link.split('zoneinfo/', 1)[1]
    except (OSError, IndexError):
        return 'UTC'


def phase_settings(st):
    heading('Settings for the new system')
    s = {}
    s['hostname'] = ask('Hostname', 'googlebook')
    while True:
        s['user'] = ask('Your user name')
        if re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', s['user']) and s['user'] != 'root':
            break
        say('Use lowercase letters, digits, - and _.')
    s['fullname'] = ask('Your full name (optional)', '')
    pw = ask_password(s['user'])
    root_pw = pw if ask_yes('Use the same password for root?') else ask_password('root')
    s['user_hash'] = openssl_hash(pw)
    s['root_hash'] = openssl_hash(root_pw)
    while True:
        s['timezone'] = ask('Time zone', guess_timezone())
        if Path('/usr/share/zoneinfo', s['timezone']).is_file() or \
                not Path('/usr/share/zoneinfo').is_dir():
            break
        say('Unknown time zone (try e.g. America/Chicago or Europe/Berlin).')
    s['locale'] = ask('Locale', 'en_US.UTF-8')
    s['keymap'] = ask('Console keymap', 'us')
    say(ENCRYPT_HELP)
    s['encrypt'] = ask_yes('Encrypt the root filesystem?', default=False)
    if s['encrypt'] and not shutil.which('cryptsetup'):
        raise Abort('encryption needs cryptsetup on this PC too (to create the '
                    'container); install it and run --from settings')
    keys = sorted(Path.home().glob('.ssh/id_*.pub'))
    s['ssh_key'] = ''
    if keys and ask_yes(f'Allow SSH logins with your key {keys[0]}?'):
        s['ssh_key'] = keys[0].read_text().strip()
    st['settings'] = s


