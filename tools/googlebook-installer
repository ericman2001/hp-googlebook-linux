    heading('Downloads')
    have = st.get('stage3')
    if not (have and Path(have).exists()):
        local = ask('Path to a stage3-arm64-desktop-systemd-*.tar.xz you already '
                    'have (Enter to download the latest)', '')
        if local:
            p = Path(local).expanduser().resolve()
            if not p.is_file() or not re.match(r'stage3-arm64-desktop-systemd-.*\.tar\.xz$', p.name):
                raise Abort(f'{p} is not a stage3-arm64-desktop-systemd tarball')
            have = str(p)
