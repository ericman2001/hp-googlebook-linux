def phase_flash(st):
    heading('Flashing the laptop')
    ip = st['ip']
    if not wait_for_fastboot(ip):
        say(FASTBOOT_STEPS)
        ip = ask('IP address shown on the laptop', ip)
        if not wait_for_fastboot(ip, tries=10):
            raise Abort(f'no fastboot at {ip}')
        st['ip'] = ip
    if getvar(ip, 'serialno') != st['serial']:
        raise Abort('this is a different laptop than the one this install was set up for')
    slot = st['slot']
    other = 'b' if slot == 'a' else 'a'
    if getvar(ip, 'current-slot').lstrip('_') != st['active_slot']:
        raise Abort('the laptop switched slots since the device phase (an Android '
                    'update?); run the installer with --from device')
    simg = WORK / 'rootfs.simg'
    fs_size = sparse_image_size(simg)
    part = int(getvar(ip, 'partition-size:userdata'), 16)
    if fs_size > part:
        raise Abort(f'the root filesystem ({fs_size >> 30} GiB) is bigger than userdata')
    say(FLASH_WARNING.format(s=slot, S=slot.upper(), O=other.upper()))
    if ask('Type ERASE to go ahead', '') != 'ERASE':
        raise Abort('not flashed')
    out = WORK / 'out'
    for p in BOOT_IMAGES:
        fastboot(ip, 'flash', f'{p}_{slot}', str(out / f'{p}.img'))
    say(f'  userdata: {simg.stat().st_size >> 20} MiB, a few minutes')
    fastboot(ip, 'flash', 'userdata', str(simg))
    fastboot(ip, 'set_active', slot)
    say('  rebooting into Gentoo')
    fastboot(ip, 'reboot')


def sparse_image_size(path):
    """The size of the filesystem in an Android sparse image."""
    with open(path, 'rb') as f:
        magic, _, _, _, _, blk, total = struct.unpack('<IHHHHII', f.read(20))
    if magic != 0xed26ff3a:
        raise Abort(f'{path} is not a sparse image')
    return blk * total


