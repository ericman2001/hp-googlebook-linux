    say(f'  kernel: {k}')
    for name, digest in LFW_FILES.items():
        download(LFW_URL.format(name), DL / 'linux-firmware' / name, digest)
    say(f'  linux-firmware {LFW_TAG}: {len(LFW_FILES)} files')


def download_stage3():
    latest = fetch_text(STAGE3_LATEST)
    m = re.search(r'^(\S+/(stage3-arm64-desktop-systemd-\S+\.tar\.xz)) \d+$',
                  latest, re.M)
    if not m:
        raise Abort('could not find the latest stage3 in ' + STAGE3_LATEST)
    url = f'{STAGE3_BASE}/{m.group(1)}'
    sums = fetch_text(url + '.sha256')
    if shutil.which('gpg'):
        verify_gentoo_signature(sums)
    digest = re.search(r'^([0-9a-f]{64})  ' + re.escape(m.group(2)) + '$', sums, re.M)
    if not digest:
        raise Abort('no SHA-256 for ' + m.group(2))
    return download(url, DL / m.group(2), digest.group(1))


def verify_gentoo_signature(text):
    with tempfile.TemporaryDirectory() as home:
        keys = Path(home) / 'keys.gpg'
        download(GENTOO_KEYS, keys)
        env = {'GNUPGHOME': home}
        run(['gpg', '--batch', '--quiet', '--import', str(keys)], log='gpg', env=env)
        msg = Path(home) / 'sums.asc'
        msg.write_text(text)
        run(['gpg', '--batch', '--verify', str(msg)], log='gpg', env=env)
    say('  stage3 checksum signature: good (Gentoo release key)')


