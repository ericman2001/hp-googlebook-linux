# Kernel config fragment for the HP Googlebook (Quartz), applied on top of
# arm64 defconfig with scripts/kconfig/merge_config.sh.

# Console on the firmware splash framebuffer, described in the DT
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_GOOGLE_FRAMEBUFFER_COREBOOT is not set

# Coreboot table, for the firmware log in /sys/firmware/log
CONFIG_GOOGLE_COREBOOT_TABLE=y
CONFIG_GOOGLE_MEMCONSOLE_COREBOOT=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Readable console on the 2880x1800 panel (select with fbcon=font:TER16x32)
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Chrome EC (keyboard) on QUP SE13 SPI; QUP serial engines may use GPI DMA
CONFIG_SPI_QCOM_GENI=y
# /dev/cros_ec, for talking to the EC from userspace
CONFIG_CROS_EC_CHARDEV=y
# Raw SPI access to the EC from userspace (ecspi)
CONFIG_SPI_SPIDEV=y
CONFIG_QCOM_GPI_DMA=y

# Depthcharge adds a ramoops region; keep panic logs across warm reboots
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# Depthcharge appends an Android bootconfig blob to the ramdisk
CONFIG_BOOT_CONFIG=y

# Bring-up: per-driver debug messages via dyndbg= on the command line
CONFIG_DYNAMIC_DEBUG=y

# USB-C ports: eUSB2 PHYs and SMB2360 repeaters
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

# Root on the internal NVMe (PCIe 6A) or a USB disk without needing modules
CONFIG_BLK_DEV_NVME=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y

# USB Ethernet adapter, for netconsole/SSH during bring-up
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y

CONFIG_LOCALVERSION="-quartz"
# CONFIG_LOCALVERSION_AUTO is not set

# Boot path pieces that don't map through modules.builtin
CONFIG_PCIE_QCOM=y
CONFIG_PCIEPORTBUS=y
CONFIG_CPU_IDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
CONFIG_SRAM=y
# Root filesystem and early userspace without modules
CONFIG_EXT4_FS=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
# Parents the resolver cannot infer
CONFIG_GOOGLE_FIRMWARE=y
CONFIG_USB_DWC3=y

# USB-C USB 3 and DisplayPort: the dwc3 controllers wait for the QMP combo
# PHYs, so build them in for USB in the rescue initramfs (they need Type-C)
CONFIG_TYPEC=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# The fingerprint MCU takes ChromeOS EC host commands over USB
CONFIG_CROS_EC_USB=m
