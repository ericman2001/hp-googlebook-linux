From c2e04d31c39c34bd8fb5fdfa6da99ac01754fda8 Mon Sep 17 00:00:00 2001
From: ericman2001 <ericman2001@hotmail.com>
Date: Sat, 17 Oct 2026 23:35:13 -0500
Subject: [PATCH 10/13] arm64: dts: qcom: x1e80100-google-quartz: Enable the
 display and GPU

The eDP panel (a Samsung 2880x1800 120 Hz OLED) is on DP3 and wired like
on the CRD: panel power on TLMM GPIO 70, the panel enable on PMC8380 #3
GPIO 4, and brightness over the AUX channel, since Quartz has no PWM
backlight. L2J and L3J feed the eDP PHY and stay on, as they also feed
PHYs not described yet. The GPU doesn't need the zap shader at EL2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/x1e80100-google-quartz.dts  | 116 +++++++++++++++++-
 1 file changed, 110 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
index 98fdc6e7f..53814b3f6 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
@@ -5,7 +5,7 @@
  * Boots through coreboot + depthcharge with Linux entered at EL2, so the
  * Gunyah-specific parts of hamoa.dtsi are adjusted as in x1-el2.dtso.
  *
- * Supported so far: the SoC core, the firmware framebuffer, the Chrome EC
+ * Supported so far: the SoC core, the eDP panel and the GPU, the Chrome EC
  * with the keyboard, the touchpad and touchscreen, USB 2.0 on both USB-C
  * ports, the NVMe SSD, Wi-Fi and Bluetooth. Other peripherals and the board
  * regulators are left out until their wiring is ported from the stock vendor
@@ -171,6 +171,22 @@ vreg_pmu_pcie_1p8: ldo9 {
 		};
 	};
 
+	vreg_edp_3p3: regulator-edp-3p3 {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_EDP_3P3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+
+		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-0 = <&edp_reg_en>;
+		pinctrl-names = "default";
+
+		regulator-boot-on;
+	};
+
 	vreg_nvme: regulator-nvme {
 		compatible = "regulator-fixed";
 
@@ -284,6 +300,28 @@ vreg_l3i_0p8: ldo3 {
 			regulator-always-on;
 		};
 	};
+
+	/* eDP PHY; also feeds the USB QMP PHYs and PCIe refclocks */
+	regulators-3 {
+		compatible = "qcom,pm8550ve-rpmh-regulators";
+		qcom,pmic-id = "j";
+
+		vreg_l2j_1p2: ldo2 {
+			regulator-name = "vreg_l2j_1p2";
+			regulator-min-microvolt = <1256000>;
+			regulator-max-microvolt = <1256000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+
+		vreg_l3j_0p8: ldo3 {
+			regulator-name = "vreg_l3j_0p8";
+			regulator-min-microvolt = <880000>;
+			regulator-max-microvolt = <920000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+			regulator-always-on;
+		};
+	};
 };
 
 &apss_watchdog {
@@ -298,11 +336,6 @@ &gpi_dma1 {
 	status = "okay";
 };
 
-/*
- * No display driver yet, but as long as MDSS is enabled and unbound, the
- * interconnect providers don't sync_state() and keep the bandwidth that
- * the firmware-initialised display (simple-framebuffer) depends on.
- */
 &i2c0 {
 	clock-frequency = <400000>;
 
@@ -347,10 +380,64 @@ touchscreen@15 {
 	};
 };
 
+&gpu {
+	status = "okay";
+};
+
+/* Linux at EL2 resets the GPU itself */
+&gpu_zap_shader {
+	status = "disabled";
+};
+
 &mdss {
 	status = "okay";
 };
 
+/*
+ * The eDP panel, wired like on the CRD: panel power on GPIO 70, backlight
+ * enable on PMC8380 #3 GPIO 4 and the brightness set over the AUX channel
+ * (the panel has no PWM input on Quartz).
+ */
+&mdss_dp3 {
+	/delete-property/ #sound-dai-cells;
+
+	pinctrl-0 = <&edp0_hpd_default>;
+	pinctrl-names = "default";
+
+	status = "okay";
+
+	aux-bus {
+		panel {
+			compatible = "edp-panel";
+			enable-gpios = <&pmc8380_3_gpios 4 GPIO_ACTIVE_HIGH>;
+			power-supply = <&vreg_edp_3p3>;
+
+			pinctrl-0 = <&edp_bl_en>;
+			pinctrl-names = "default";
+
+			port {
+				edp_panel_in: endpoint {
+					remote-endpoint = <&mdss_dp3_out>;
+				};
+			};
+		};
+	};
+};
+
+&mdss_dp3_out {
+	data-lanes = <0 1 2 3>;
+	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
+
+	remote-endpoint = <&edp_panel_in>;
+};
+
+&mdss_dp3_phy {
+	vdda-phy-supply = <&vreg_l3j_0p8>;
+	vdda-pll-supply = <&vreg_l2j_1p2>;
+
+	status = "okay";
+};
+
 /*
  * NVMe SSD. Its MSIs go to the controller's own MSI receiver, since the GIC
  * ITS is unavailable; DMA goes through the PCIe SMMU, as in x1-el2.dtso.
@@ -570,6 +657,16 @@ MATRIX_KEY(14, 11, KEY_PAGEDOWN)
 	};
 };
 
+&pmc8380_3_gpios {
+	edp_bl_en: edp-bl-en-state {
+		pins = "gpio4";
+		function = "normal";
+		power-source = <1>; /* 1.8V */
+		input-disable;
+		output-enable;
+	};
+};
+
 &smb2360_0 {
 	status = "okay";
 };
@@ -716,6 +813,13 @@ ts_vdd_en: ts-vdd-en-state {
 		bias-disable;
 	};
 
+	edp_reg_en: edp-reg-en-state {
+		pins = "gpio70";
+		function = "gpio";
+		drive-strength = <16>;
+		bias-disable;
+	};
+
 	pcie4_default: pcie4-default-state {
 		clkreq-n-pins {
 			pins = "gpio147";
-- 
2.55.0

