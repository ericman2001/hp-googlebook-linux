From 149c2085866502a0c7dfbd2ccbf9dca701ed9b6c Mon Sep 17 00:00:00 2001
From: ericman2001 <ericman2001@hotmail.com>
Date: Sat, 17 Oct 2026 23:35:13 -0500
Subject: [PATCH 09/10] drm/panel-edp: Leave the enable GPIO alone when the
 panel is already powered

When the firmware has lit the panel, its supply is still on when
panel-edp probes, but requesting the enable GPIO as GPIOD_OUT_LOW drops
the enable line right away. Samsung OLED panels (such as the SDC 0x4215
in the HP Googlebook) then stay dark when the line is raised again,
until they are power cycled: the link trains and the panel reports a
synchronized, error-free stream, but it emits no light.

Request the GPIO as-is when the supply is already enabled, so a panel
the firmware turned on stays on until panel-edp's own power-off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/panel/panel-edp.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-edp.c b/drivers/gpu/drm/panel/panel-edp.c
index ac815729a..c100be0e7 100644
--- a/drivers/gpu/drm/panel/panel-edp.c
+++ b/drivers/gpu/drm/panel/panel-edp.c
@@ -844,6 +844,7 @@ static int panel_edp_probe(struct device *dev, const struct panel_desc *desc,
 	struct panel_edp *panel;
 	struct display_timing dt;
 	struct device_node *ddc;
+	enum gpiod_flags enable_flags;
 	int err;
 
 	panel = devm_drm_panel_alloc(dev, struct panel_edp, base,
@@ -866,11 +867,24 @@ static int panel_edp_probe(struct device *dev, const struct panel_desc *desc,
 	if (IS_ERR(panel->supply))
 		return PTR_ERR(panel->supply);
 
+	/*
+	 * If the firmware left the panel powered, leave its enable line alone.
+	 * Some panels (Samsung OLEDs, for one) stay dark if the enable line
+	 * drops while they stay powered, until they are power cycled.
+	 */
+	enable_flags = regulator_is_enabled(panel->supply) > 0 ?
+		       GPIOD_ASIS : GPIOD_OUT_LOW;
 	panel->enable_gpio = devm_gpiod_get_optional(dev, "enable",
-						     GPIOD_OUT_LOW);
+						     enable_flags);
 	if (IS_ERR(panel->enable_gpio))
 		return dev_err_probe(dev, PTR_ERR(panel->enable_gpio),
 				     "failed to request GPIO\n");
+	if (panel->enable_gpio && enable_flags == GPIOD_ASIS &&
+	    gpiod_get_direction(panel->enable_gpio) == GPIO_LINE_DIRECTION_IN) {
+		err = gpiod_direction_output(panel->enable_gpio, 0);
+		if (err)
+			return err;
+	}
 
 	err = of_drm_get_panel_orientation(dev->of_node, &panel->orientation);
 	if (err) {
-- 
