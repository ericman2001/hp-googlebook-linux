From 4bdb7e71f0314df565cab988cc7bea8ae1d02e3f Mon Sep 17 00:00:00 2001
From: ericman2001 <ericman2001@hotmail.com>
Date: Sat, 17 Oct 2026 23:35:12 -0500
Subject: [PATCH 03/14] arm64: dts: qcom: x1e80100-google-quartz: Enable USB
 2.0 on the USB-C ports

Include the PMICs and enable the two SMB2360s whose eUSB2 repeaters serve
the USB-C ports, as in the stock DT. Run both DWC3 controllers as USB 2.0
hosts for now: the QMP PHYs, PS8830 retimers and pmic_glink aren't
described yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/x1e80100-google-quartz.dts  | 50 ++++++++++++++++++-
 1 file changed, 48 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
index e2d147da3..e6f935c42 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
@@ -5,8 +5,8 @@
  * Boots through coreboot + depthcharge with Linux entered at EL2, so the
  * Gunyah-specific parts of hamoa.dtsi are adjusted as in x1-el2.dtso.
  *
- * Supported so far: the SoC core, the firmware framebuffer and the Chrome EC
- * with the keyboard. Other peripherals and the board regulators are left out
+ * Supported so far: the SoC core, the firmware framebuffer, the Chrome EC
+ * with the keyboard and USB 2.0 on both USB-C ports. Other peripherals and the board regulators are left out
  * until their wiring is ported from the stock vendor device tree.
  */
 
@@ -15,6 +15,7 @@
 #include <dt-bindings/input/input.h>
 
 #include "hamoa.dtsi"
+#include "hamoa-pmics.dtsi"
 
 /* Placed differently by this firmware, recreated below at the stock addresses */
 /delete-node/ &adsp_rpc_remote_heap_mem;
@@ -228,6 +229,51 @@ MATRIX_KEY(14, 11, KEY_PAGEDOWN)
 	};
 };
 
+&smb2360_0 {
+	status = "okay";
+};
+
+&smb2360_1 {
+	status = "okay";
+};
+
+/*
+ * USB-C ports, USB 2.0 only for now: the QMP PHYs, PS8830 retimers and
+ * pmic_glink (orientation, roles) aren't described yet. The PHY and
+ * repeater supplies are left on by the firmware.
+ */
+&usb_1_ss0_hsphy {
+	phys = <&smb2360_0_eusb2_repeater>;
+
+	status = "okay";
+};
+
+&usb_1_ss0 {
+	phys = <&usb_1_ss0_hsphy>;
+	phy-names = "usb2-phy";
+	maximum-speed = "high-speed";
+	qcom,select-utmi-as-pipe-clk;
+	dr_mode = "host";
+
+	status = "okay";
+};
+
+&usb_1_ss1_hsphy {
+	phys = <&smb2360_1_eusb2_repeater>;
+
+	status = "okay";
+};
+
+&usb_1_ss1 {
+	phys = <&usb_1_ss1_hsphy>;
+	phy-names = "usb2-phy";
+	maximum-speed = "high-speed";
+	qcom,select-utmi-as-pipe-clk;
+	dr_mode = "host";
+
+	status = "okay";
+};
+
 /* Disabled (and its MMIO reserved) in the stock DTB as well */
 &gic_its {
 	status = "disabled";
-- 
