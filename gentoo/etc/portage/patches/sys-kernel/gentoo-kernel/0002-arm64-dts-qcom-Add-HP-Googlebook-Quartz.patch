 arch/arm64/boot/dts/qcom/Makefile             |   3 +
 .../boot/dts/qcom/x1e80100-google-quartz.dts  | 254 ++++++++++++++++++
 2 files changed, 257 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 6f33c4e2f..40ff6f644 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -427,6 +427,9 @@ x1e80100-dell-latitude-7455-el2-dtbs	:= x1e80100-dell-latitude-7455.dtb x1-el2.d
 dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-dell-latitude-7455.dtb x1e80100-dell-latitude-7455-el2.dtb
 x1e80100-dell-xps13-9345-el2-dtbs	:= x1e80100-dell-xps13-9345.dtb x1-el2.dtbo
 dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-dell-xps13-9345.dtb x1e80100-dell-xps13-9345-el2.dtb
+# depthcharge applies the dtbo partition's overlays onto this base DTB
+DTC_FLAGS_x1e80100-google-quartz := -@
+dtb-$(CONFIG_ARCH_QCOM)	+= x1e80100-google-quartz.dtb
