 x1e80100-hp-omnibook-x14-el2-dtbs	:= x1e80100-hp-omnibook-x14.dtb x1-el2.dtbo
diff --git a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
new file mode 100644
index 000000000..e2d147da3
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * HP Googlebook "Quartz" (Google Bluey baseboard), Snapdragon X Elite.
+ *
+ * Boots through coreboot + depthcharge with Linux entered at EL2, so the
+ * Gunyah-specific parts of hamoa.dtsi are adjusted as in x1-el2.dtso.
+ *
+ * Supported so far: the SoC core, the firmware framebuffer and the Chrome EC
+ * with the keyboard. Other peripherals and the board regulators are left out
+ * until their wiring is ported from the stock vendor device tree.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+
+#include "hamoa.dtsi"
+
+/* Placed differently by this firmware, recreated below at the stock addresses */
+/delete-node/ &adsp_rpc_remote_heap_mem;
+/delete-node/ &tz_stat_mem;
+/* Used by the Windows firmware's XBL only; not reserved in the stock map */
+/delete-node/ &xbl_tmp_buffer_mem;
+
+/ {
+	model = "Google Quartz (HP Googlebook)";
+	compatible = "google,quartz", "qcom,x1e80100";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* eDP panel as set up by coreboot (see "framebuffer_info" in its log) */
+		framebuffer@e4800000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xe4800000 0x0 (2880 * 1800 * 4)>;
+			width = <2880>;
+			height = <1800>;
+			stride = <(2880 * 4)>;
+			format = "x8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap@82000000 {
+			reg = <0x0 0x82000000 0x0 0x800000>;
+			no-map;
+		};
+
+		tz_stat_mem: tz-stat@82800000 {
+			reg = <0x0 0x82800000 0x0 0x100000>;
+			no-map;
+		};
+
+		/* Firmware regions from the stock DTB that hamoa.dtsi doesn't cover */
+		wlan-msa@85380000 {
+			reg = <0x0 0x85380000 0x0 0xc00000>;
+			no-map;
+		};
+
+		/* Firmware splash framebuffer, handed over through the coreboot table */
+		splash-region@e4800000 {
+			reg = <0x0 0xe4800000 0x0 0x21c0000>;
+			no-map;
+		};
+	};
+};
+
+/* Not reserved by a hypervisor when running at EL2 */
+&apss_watchdog {
+	status = "okay";
+};
+
+&gpi_dma1 {
+	status = "okay";
+};
+
+/*
+ * No display driver yet, but as long as MDSS is enabled and unbound, the
+ * interconnect providers don't sync_state() and keep the bandwidth that
+ * the firmware-initialised display (simple-framebuffer) depends on.
+ */
+&mdss {
+	status = "okay";
+};
+
+&qupv3_1 {
+	status = "okay";
+};
+
+&spi13 {
+	status = "okay";
+
+	cros_ec: ec@0 {
+		compatible = "google,cros-ec-spi";
+		reg = <0>;
+		interrupts-extended = <&tlmm 66 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-0 = <&ap_ec_int_l>;
+		pinctrl-names = "default";
+		spi-max-frequency = <3000000>;
+		wakeup-source;
+
+		keyboard-controller {
+			compatible = "google,cros-ec-keyb";
+			keypad,num-rows = <8>;
+			keypad,num-columns = <18>;
+			google,needs-ghost-filter;
+			/* From the stock DTB; rows 8-15 are the Fn layer */
+			linux,keymap = <
+				MATRIX_KEY(0, 3, KEY_B)
+				MATRIX_KEY(0, 5, KEY_N)
+				MATRIX_KEY(0, 6, KEY_RO)
+				MATRIX_KEY(0, 8, KEY_EQUAL)
+				MATRIX_KEY(0, 9, KEY_HOME)
+				MATRIX_KEY(0, 10, KEY_RIGHTALT)
+				MATRIX_KEY(0, 16, KEY_FN)
+				MATRIX_KEY(1, 1, KEY_ESC)
+				MATRIX_KEY(1, 3, KEY_G)
+				MATRIX_KEY(1, 6, KEY_H)
+				MATRIX_KEY(1, 8, KEY_APOSTROPHE)
+				MATRIX_KEY(1, 11, KEY_BACKSPACE)
+				MATRIX_KEY(1, 12, KEY_HENKAN)
+				MATRIX_KEY(1, 14, KEY_LEFTCTRL)
+				MATRIX_KEY(2, 1, KEY_TAB)
+				MATRIX_KEY(2, 3, KEY_T)
+				MATRIX_KEY(2, 5, KEY_RIGHTBRACE)
+				MATRIX_KEY(2, 6, KEY_Y)
+				MATRIX_KEY(2, 8, KEY_LEFTBRACE)
+				MATRIX_KEY(2, 9, KEY_DELETE)
+				MATRIX_KEY(2, 12, KEY_PAGEUP)
+				MATRIX_KEY(2, 17, KEY_YEN)
+				MATRIX_KEY(3, 0, KEY_LEFTMETA)
+				MATRIX_KEY(3, 1, KEY_GRAVE)
+				MATRIX_KEY(3, 3, KEY_5)
