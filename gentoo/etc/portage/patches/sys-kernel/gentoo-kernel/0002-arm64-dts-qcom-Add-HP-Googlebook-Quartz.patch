+			>;
+		};
+	};
+};
+
+/* Disabled (and its MMIO reserved) in the stock DTB as well */
+&gic_its {
+	status = "disabled";
+};
+
+/* Implemented in software by Gunyah, which isn't present on this firmware */
+&sbsa_watchdog {
+	status = "disabled";
+};
+
+/*
+ * Owned by the secure world; touching them raises a NoC error that
+ * QTEE treats as fatal. Same ranges as the stock DTB.
+ */
+&tlmm {
+	gpio-reserved-ranges = <34 2>, /* Unused */
+			       <44 4>; /* SPI (TPM) */
+
+	ap_ec_int_l: ap-ec-int-l-state {
+		pins = "gpio66";
+		function = "gpio";
+		bias-disable;
+	};
+};
