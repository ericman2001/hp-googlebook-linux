From 5fa57768b7b44fdbf644277755e45fecf29d4780 Mon Sep 17 00:00:00 2001
From: ericman2001 <ericman2001@hotmail.com>
Date: Sun, 18 Oct 2026 00:39:14 -0500
Subject: [PATCH 13/17] arm64: dts: qcom: x1e80100-google-quartz: Enable the
 ADSP and battery

The ADSP runs the battery charger: without it the battery doesn't charge
at all. Load the laptop's own signed firmware (split .mdt files, from the
stock modem partition) and add pmic-glink for the battery. USB-C (UCSI,
alt modes) comes later.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/x1e80100-google-quartz.dts  | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
index 53814b3f6..390f26298 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
@@ -171,6 +171,18 @@ vreg_pmu_pcie_1p8: ldo9 {
 		};
 	};
 
+	/*
+	 * Battery and charger, through the ADSP firmware. USB-C (UCSI, alt
+	 * modes) isn't described yet.
+	 */
+	pmic-glink {
+		compatible = "qcom,x1e80100-pmic-glink",
+			     "qcom,sm8550-pmic-glink",
+			     "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
 	vreg_edp_3p3: regulator-edp-3p3 {
 		compatible = "regulator-fixed";
 
@@ -667,6 +679,19 @@ edp_bl_en: edp-bl-en-state {
 	};
 };
 
+/*
+ * The ADSP runs the battery charger and USB-C services. At EL2 its IOMMU
+ * stream isn't set up by a hypervisor, and the Chrome OS TrustZone can't
+ * provide a resource table, so it runs with an identity mapping.
+ */
+&remoteproc_adsp {
+	firmware-name = "qcom/x1e80100/google/quartz/adsp.mdt",
+			"qcom/x1e80100/google/quartz/adsp_dtb.mdt";
+	iommus = <&apps_smmu 0x1000 0x80>;
+
+	status = "okay";
+};
+
 &smb2360_0 {
 	status = "okay";
 };
