From c3a890fc43078e08fa46a985ed9cc483c9e068ae Mon Sep 17 00:00:00 2001
From: ericman2001 <ericman2001@hotmail.com>
Date: Sun, 18 Oct 2026 01:17:53 -0500
Subject: [PATCH 14/14] arm64: dts: qcom: x1e80100-google-quartz: Enable USB 3
 and DisplayPort on USB-C

Both USB-C ports are wired like the first two on the CRD: PS8830
retimers on I2C 3 and 7 with the same supplies and reset lines, the QMP
combo PHYs on the same rails, and orientation on GPIOs 121 and 123.
Describe them, the pmic-glink connectors and the DP controllers, and
drop the USB 2.0-only workaround on the dwc3 controllers.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/x1e80100-google-quartz.dts  | 460 +++++++++++++++++-
 1 file changed, 441 insertions(+), 19 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
index 390f26298..6118f379f 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-google-quartz.dts
@@ -6,10 +6,10 @@
  * Gunyah-specific parts of hamoa.dtsi are adjusted as in x1-el2.dtso.
  *
  * Supported so far: the SoC core, the eDP panel and the GPU, the Chrome EC
- * with the keyboard, the touchpad and touchscreen, USB 2.0 on both USB-C
- * ports, the NVMe SSD, Wi-Fi and Bluetooth. Other peripherals and the board
- * regulators are left out until their wiring is ported from the stock vendor
- * device tree.
+ * with the keyboard, the touchpad and touchscreen, both USB-C ports (USB 3,
+ * DisplayPort alt mode), the NVMe SSD, Wi-Fi, Bluetooth, and the ADSP with
+ * the battery charger. Other peripherals and the board regulators are left
+ * out until their wiring is ported from the stock vendor device tree.
  */
 
 /dts-v1/;
@@ -172,8 +172,8 @@ vreg_pmu_pcie_1p8: ldo9 {
 	};
 
 	/*
-	 * Battery and charger, through the ADSP firmware. USB-C (UCSI, alt
-	 * modes) isn't described yet.
+	 * Battery, charger and USB-C, through the ADSP firmware. The two
+	 * USB-C ports are wired like the CRD's first two.
 	 */
