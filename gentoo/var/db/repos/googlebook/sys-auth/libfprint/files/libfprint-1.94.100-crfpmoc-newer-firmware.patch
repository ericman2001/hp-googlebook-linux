From: ericman2001 <ericman2001@hotmail.com>
Subject: crfpmoc: Fixes for newer FPMCU firmware, enrolling and reboots

Tested on the HP Googlebook's FPMCU ("niedzica" firmware, over USB):

* It only implements EC_CMD_FP_INFO v3. Retry a v1 request it rejects with
  EC_RES_INVALID_VERSION as v3 and convert the response to the v1 layout.
* EC_CMD_FP_MODE always returns the mode, and the kernel rejects a response
  longer than the buffer (EMSGSIZE), so give every FP_MODE request room for
  it. This made enrolling fail right away while clearing the storage.
* Fix crfpmoc_read_bytes()'s signature: a pollable source calls a
  GPollableSourceFunc, with the stream as the first argument, which the
  driver took for its state machine (crash as soon as an event arrived).
* Wait for the finger to be lifted before setting the context when
  enrolling, as verifying already does: setting it recalibrates the sensor,
  and with the finger still on it from fprintd's duplicate check, the ELAN
  sensor detected nothing afterwards.
* Keep the seed (and the user context) in a root-only file,
  /var/lib/fprint/crfpmoc-keys, generated once with getrandom(). The MCU
  derives the template key from the seed and forgets it on every reset,
  so a fresh random seed per session made every print fail to decrypt
  after a reboot ("Failed to decipher template", EC_RES_UNAVAILABLE).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/libfprint/drivers/crfpmoc/crfpmoc-ec-transfer.c b/libfprint/drivers/crfpmoc/crfpmoc-ec-transfer.c
index 4b9584f..a09ef9d 100644
--- a/libfprint/drivers/crfpmoc/crfpmoc-ec-transfer.c
+++ b/libfprint/drivers/crfpmoc/crfpmoc-ec-transfer.c
@@ -118,6 +118,74 @@ do_ioctl_xcmd (CrfpMocEcTransfer                 *transfer,
   return r;
 }
 
+/*
+ * Newer FPMCU firmware only implements EC_CMD_FP_INFO v3. Retry a v1 request
+ * that it rejects as v3 and hand back the v1 layout, so that the rest of the
+ * driver doesn't need to know.
+ */
+static int
+do_fp_info_v3_fallback (CrfpMocEcTransfer                  *transfer,
+                        struct crfpmoc_cros_ec_command_v2 **s_cmd,
+                        GError                            **error)
+{
+  struct crfpmoc_ec_response_fp_info_v3 *v3;
+  struct crfpmoc_ec_response_fp_info v1 = { 0 };
+  struct crfpmoc_cros_ec_command_v2 *cmd;
+  CrfpMocEcTransfer v3_transfer;
+  int r;
+
+  if (transfer->insize < sizeof (v1) || !transfer->indata)
+    return -1;
+
+  fp_dbg ("FP_INFO v1 not supported, trying v3");
+
+  v3_transfer = *transfer;
+  v3_transfer.version = 3;
+  v3_transfer.insize = sizeof (*v3);
+  v3_transfer.indata = NULL;
+
+  cmd = build_raw_cmd (&v3_transfer);
+  g_free (*s_cmd);
+  *s_cmd = cmd;
+
+  g_clear_error (error);
+  r = do_ioctl_xcmd (&v3_transfer, cmd, error);
+  if (r < 0)
+    return r;
+  if (r < G_STRUCT_OFFSET (struct crfpmoc_ec_response_fp_info_v3,
+                           image_frame_params))
+    {
+      g_set_error (error, FP_DEVICE_ERROR, FP_DEVICE_ERROR_PROTO,
+                   "FP_INFO v3 response too short (%d bytes)", r);
+      return -1;
+    }
+
+  v3 = (struct crfpmoc_ec_response_fp_info_v3 *) cmd->data;
+  v1.vendor_id = v3->vendor_id;
+  v1.product_id = v3->product_id;
+  v1.model_id = v3->model_id;
+  v1.version = v3->version;
+  v1.errors = v3->errors;
+  v1.template_size = v3->template_size;
+  v1.template_max = v3->template_max;
+  v1.template_valid = v3->template_valid;
+  v1.template_dirty = v3->template_dirty;
+  v1.template_version = v3->template_version;
+  if (v3->num_capture_types > 0 &&
+      r >= G_STRUCT_OFFSET (struct crfpmoc_ec_response_fp_info_v3,
+                            image_frame_params[1]))
+    {
+      v1.frame_size = v3->image_frame_params[0].frame_size;
+      v1.pixel_format = v3->image_frame_params[0].pixel_format;
+      v1.width = v3->image_frame_params[0].width;
+      v1.height = v3->image_frame_params[0].height;
+      v1.bpp = v3->image_frame_params[0].bpp;
+    }
+
+  memcpy (transfer->indata, &v1, sizeof (v1));
+  return sizeof (v1);
+}
+
 static void
 command_thread_func (GTask        *task,
                      gpointer      source_object,
@@ -136,6 +204,9 @@ command_thread_func (GTask        *task,
   s_cmd = build_raw_cmd (transfer);
 
   r = do_ioctl_xcmd (transfer, s_cmd, &error);
+  if (r < 0 && s_cmd->result == EC_RES_INVALID_VERSION &&
+      transfer->command == CRFPMOC_EC_CMD_FP_INFO && transfer->version == 1)
+    r = do_fp_info_v3_fallback (transfer, &s_cmd, &error);
 
   if (crfpmoc_umockdev_recording_enabled (FPI_DEVICE_CRFPMOC (transfer->device)))
     {
@@ -355,6 +426,9 @@ crfpmoc_ec_transfer_submit_sync (CrfpMocEcTransfer *transfer,
 
   s_cmd = build_raw_cmd (transfer);
   r = do_ioctl_xcmd (transfer, s_cmd, error);
+  if (r < 0 && s_cmd->result == EC_RES_INVALID_VERSION &&
+      transfer->command == CRFPMOC_EC_CMD_FP_INFO && transfer->version == 1)
+    r = do_fp_info_v3_fallback (transfer, &s_cmd, error);
 
   if (crfpmoc_umockdev_recording_enabled (FPI_DEVICE_CRFPMOC (transfer->device)))
     crfpmoc_umockdev_record (FPI_DEVICE_CRFPMOC (transfer->device), r,
