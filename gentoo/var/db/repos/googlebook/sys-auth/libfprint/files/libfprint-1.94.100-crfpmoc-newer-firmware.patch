-/* Initialise the per-session encryption seed and user context. In emulation
- * mode fixed test values are used so the recorded ioctl replay stays
- * deterministic; on real hardware random values are generated.
+/*
+ * The MCU derives the template encryption key from the seed, and forgets
+ * the seed when it resets (on every reboot). Templates are stored on the
+ * host, so the seed has to be the same every time, or every print stops
+ * matching after a reboot ("Failed to decipher template"). ChromeOS gets it
+ * from the TPM; keep it in a root-only file instead, next to fprintd's
+ * prints, with the user context.
+ */
+#define CRFPMOC_KEYS_DIR  "/var/lib/fprint"
+#define CRFPMOC_KEYS_FILE CRFPMOC_KEYS_DIR "/crfpmoc-keys"
+
+static gboolean
+crfpmoc_load_keys (FpiDeviceCrfpMoc *self)
+{
+  g_autoptr(GError) error = NULL;
+  g_autofree gchar *contents = NULL;
+  gsize len = 0;
+
+  if (!g_file_get_contents (CRFPMOC_KEYS_FILE, &contents, &len, &error))
+    {
+      if (!g_error_matches (error, G_FILE_ERROR, G_FILE_ERROR_NOENT))
+        fp_warn ("Can't read %s: %s", CRFPMOC_KEYS_FILE, error->message);
+      return FALSE;
+    }
+
+  if (len != sizeof (self->seed) + sizeof (self->context))
+    {
+      fp_warn ("%s has the wrong size (%zu bytes)", CRFPMOC_KEYS_FILE, len);
+      return FALSE;
+    }
+
+  memcpy (self->seed, contents, sizeof (self->seed));
+  memcpy (self->context, contents + sizeof (self->seed), sizeof (self->context));
+  fp_dbg ("Loaded the seed and context from %s", CRFPMOC_KEYS_FILE);
+
+  return TRUE;
+}
+
+static void
+crfpmoc_save_keys (FpiDeviceCrfpMoc *self)
+{
+  g_autoptr(GError) error = NULL;
+  guint8 contents[sizeof (self->seed) + sizeof (self->context)];
+
+  memcpy (contents, self->seed, sizeof (self->seed));
+  memcpy (contents + sizeof (self->seed), self->context, sizeof (self->context));
+
+  if (g_mkdir_with_parents (CRFPMOC_KEYS_DIR, 0700) < 0 ||
+      !g_file_set_contents_full (CRFPMOC_KEYS_FILE, (const gchar *) contents,
+                                 sizeof (contents),
+                                 G_FILE_SET_CONTENTS_CONSISTENT, 0600, &error))
+    fp_warn ("Can't save the seed to %s, prints won't survive a reboot: %s",
+             CRFPMOC_KEYS_FILE, error ? error->message : g_strerror (errno));
+  else
+    fp_dbg ("Saved a new seed and context to %s", CRFPMOC_KEYS_FILE);
+
+  explicit_bzero (contents, sizeof (contents));
+}
+
+/* Initialise the encryption seed and user context. In emulation mode fixed
+ * test values are used so the recorded ioctl replay stays deterministic; on
+ * real hardware they are loaded from CRFPMOC_KEYS_FILE, or generated at
+ * random and saved there the first time.
  */
 static void
 crfpmoc_init_keys (FpiDeviceCrfpMoc *self)
@@ -1042,13 +1106,20 @@ crfpmoc_init_keys (FpiDeviceCrfpMoc *self)
       memcpy (self->seed, CRFPMOC_DEFAULT_SEED, sizeof (self->seed));
       memcpy (self->context, CRFPMOC_DEFAULT_CONTEXT, sizeof (self->context));
     }
-  else
+  else if (!crfpmoc_load_keys (self))
     {
-      for (size_t i = 0; i < sizeof (self->seed); i++)
-        self->seed[i] = (guint8) g_random_int_range (0, 256);
+      if (getrandom (self->seed, sizeof (self->seed), 0) != sizeof (self->seed) ||
+          getrandom (self->context, sizeof (self->context), 0) != sizeof (self->context))
+        {
+          fp_warn ("getrandom failed, using GRand: %s", g_strerror (errno));
+          for (size_t i = 0; i < sizeof (self->seed); i++)
+            self->seed[i] = (guint8) g_random_int_range (0, 256);
+
+          for (size_t i = 0; i < sizeof (self->context); i++)
+            self->context[i] = (guint8) g_random_int_range (0, 256);
+        }
 
-      for (size_t i = 0; i < sizeof (self->context); i++)
-        self->context[i] = (guint8) g_random_int_range (0, 256);
+      crfpmoc_save_keys (self);
     }
 }
 
