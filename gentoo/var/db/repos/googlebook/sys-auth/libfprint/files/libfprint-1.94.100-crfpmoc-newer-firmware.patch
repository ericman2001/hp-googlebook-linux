+++ b/libfprint/drivers/crfpmoc/crfpmoc.c
@@ -403,7 +403,7 @@ crfpmoc_umockdev_record (FpiDeviceCrfpMoc *self, int res,
  * to see if a timeout is active.
  */
 static gboolean
-crfpmoc_read_bytes (gpointer user_data)
+crfpmoc_read_bytes (GObject *pollable_stream, gpointer user_data)
 {
   g_autoptr(GError) error = NULL;
   FpiSsm *ssm = user_data;
@@ -593,7 +593,8 @@ crfpmoc_eventmask_cb (CrfpMocEcTransfer *transfer, GAsyncResult *res, gpointer u
   GSource *poll_source = g_pollable_input_stream_create_source (
     G_POLLABLE_INPUT_STREAM (data->poll_input_stream),
     fpi_device_get_cancellable (device));
-  g_source_set_callback (poll_source, crfpmoc_read_bytes, ssm, NULL);
+  /* A pollable source calls a GPollableSourceFunc, with the stream first */
+  g_source_set_callback (poll_source, G_SOURCE_FUNC (crfpmoc_read_bytes), ssm, NULL);
   data->poll_source = g_source_attach (poll_source, NULL);
 }
 
@@ -723,7 +724,7 @@ crfpmoc_clear_storage_cb (CrfpMocEcTransfer *transfer, GAsyncResult *res, gpoint
       data->clear_step = 1;
       p.mode = CRFPMOC_FP_MODE_RESET_SENSOR;
       new_transfer = crfpmoc_ec_transfer_new_cmd (device, CRFPMOC_EC_CMD_FP_MODE, 0,
-                                                  &p, sizeof (p), 0);
+                                                  &p, sizeof (p), sizeof (struct crfpmoc_ec_response_fp_mode));
       crfpmoc_ec_transfer_submit_cmd (new_transfer, fpi_device_get_cancellable (device),
                                       crfpmoc_clear_storage_cb, ssm);
     }
@@ -1339,7 +1340,7 @@ handle_enroll_reset (FpiSsm *ssm)
   CrfpMocEcTransfer *transfer;
 
   transfer = crfpmoc_ec_transfer_new_cmd (device, CRFPMOC_EC_CMD_FP_MODE, 0,
-                                          &p, sizeof (p), 0);
+                                          &p, sizeof (p), sizeof (struct crfpmoc_ec_response_fp_mode));
   crfpmoc_ec_transfer_submit_cmd (transfer, NULL, crfpmoc_ssm_ec_transfer_cb, ssm);
 }
 
@@ -1482,6 +1483,8 @@ handle_ensure_keys (FpiSsm *ssm)
   crfpmoc_ssm_start_subsm_full (self, sub, g_new0 (KeysData, 1), g_free);
 }
 
+static void handle_verify_finger_up (FpiSsm *ssm);
+
 static void
 crfpmoc_enroll_run_state (FpiSsm *ssm, FpDevice *device)
 {
@@ -1491,6 +1494,15 @@ crfpmoc_enroll_run_state (FpiSsm *ssm, FpDevice *device)
       handle_enroll_check_capacity (ssm);
       break;
 
+    /*
+     * Setting the context makes the sensor recalibrate. With the finger
+     * still on it from the duplicate check fprintd does first, nothing is
+     * detected afterwards (seen with an ELAN sensor), so wait for it to go.
+     */
+    case ENROLL_FINGER_UP:
+      handle_verify_finger_up (ssm);
+      break;
+
     case ENROLL_ENSURE_KEYS:
       handle_ensure_keys (ssm);
       break;
@@ -1611,7 +1623,7 @@ handle_verify_reset (FpiSsm *ssm)
   CrfpMocEcTransfer *transfer;
 
   transfer = crfpmoc_ec_transfer_new_cmd (device, CRFPMOC_EC_CMD_FP_MODE, 0,
-                                          &p, sizeof (p), 0);
+                                          &p, sizeof (p), sizeof (struct crfpmoc_ec_response_fp_mode));
   crfpmoc_ec_transfer_submit_cmd (transfer, NULL, crfpmoc_ssm_ec_transfer_cb, ssm);
 }
 
@@ -1841,7 +1853,7 @@ crfpmoc_clear_storage_run_state (FpiSsm *ssm, FpDevice *device)
       data->clear_step = 0;
 
       transfer = crfpmoc_ec_transfer_new_cmd (device, CRFPMOC_EC_CMD_FP_MODE, 0,
-                                              &p, sizeof (p), 0);
+                                              &p, sizeof (p), sizeof (struct crfpmoc_ec_response_fp_mode));
       crfpmoc_ec_transfer_submit_cmd (transfer, fpi_device_get_cancellable (device),
                                       crfpmoc_clear_storage_cb, ssm);
       break;
diff --git a/libfprint/drivers/crfpmoc/crfpmoc.h b/libfprint/drivers/crfpmoc/crfpmoc.h
index 2bc3183..478ec95 100644
--- a/libfprint/drivers/crfpmoc/crfpmoc.h
+++ b/libfprint/drivers/crfpmoc/crfpmoc.h
@@ -242,6 +242,42 @@ struct crfpmoc_ec_response_fp_info
   guint32 template_version; /* version of the template format */
 } __attribute__((packed));
 
+/*
+ * EC_CMD_FP_INFO v3, the only version newer FPMCU firmware (for example the
+ * HP Googlebook's) implements: the v1 fields, regrouped, and one set of frame
+ * parameters per capture type.
+ */
+#define CRFPMOC_FP_MAX_CAPTURE_TYPES 10
+
+struct crfpmoc_ec_response_fp_info_v3
+{
+  /* struct fp_sensor_info */
+  guint32 vendor_id;
+  guint32 product_id;
+  guint32 model_id;
+  guint32 version;
+  guint16 num_capture_types;
+  guint16 errors;
+  /* struct fp_template_info */
+  guint32 template_size;
+  guint16 template_max;
+  guint16 template_valid;
+  guint32 template_dirty;
+  guint32 template_version;
+  /* struct fp_image_frame_params_v2[] */
+  struct
+  {
+    guint32 frame_size;
+    guint32 image_data_offset_bytes;
+    guint32 pixel_format;
+    guint16 width;
+    guint16 height;
+    guint16 bpp;
+    guint8  fp_capture_type;
+    guint8  reserved;
+  } __attribute__((packed)) image_frame_params[CRFPMOC_FP_MAX_CAPTURE_TYPES];
+} __attribute__((packed));
+
 /* Note: used in crfpmoc_ec_response_get_next_data_v1 */
 struct crfpmoc_ec_response_motion_sense_fifo_info
 {
@@ -455,6 +491,7 @@ enum {
  */
 enum {
   ENROLL_CHECK_CAPACITY,       /* Reject if on-device storage is full */
+  ENROLL_FINGER_UP,            /* Make sure the finger is not on the sensor */
   ENROLL_ENSURE_KEYS,          /* Setup the seed and context */
   ENROLL_SENSOR_ENROLL_SUBMIT, /* Enter enroll mode (async submit) */
   ENROLL_SENSOR_ENROLL_DONE,   /* Enroll mode set */
